{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "containerAppName": {
      "type": "string",
      "defaultValue": "ca-ecoforecaster"
    },
    "location": {
      "type": "string",
      "defaultValue": "spaincentral"
    },
    "image": {
      "type": "string"
    },
    "managedEnvironmentId": {
      "type": "string"
    },
    "identityResourceId": {
      "type": "string"
    },
    "registryServer": {
      "type": "string"
    },
    "jwtSecret": {
      "type": "secureString"
    },
    "adminPassword": {
      "type": "secureString"
    },
    "viewerPassword": {
      "type": "secureString"
    },
    "groqApiKey": {
      "type": "secureString"
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2026-01-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": {
        "project": "ecoforecaster",
        "managed-by": "github-actions"
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[parameters('identityResourceId')]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "allowInsecure": false,
            "targetPort": 8000,
            "transport": "Auto",
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "registries": [
            {
              "server": "[parameters('registryServer')]",
              "identity": "[parameters('identityResourceId')]"
            }
          ],
          "secrets": [
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "admin-password",
              "value": "[parameters('adminPassword')]"
            },
            {
              "name": "viewer-password",
              "value": "[parameters('viewerPassword')]"
            },
            {
              "name": "groq-api-key",
              "value": "[parameters('groqApiKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "ecoforecaster",
              "image": "[parameters('image')]",
              "env": [
                {
                  "name": "ENVIRONMENT",
                  "value": "production"
                },
                {
                  "name": "JWT_SECRET_KEY",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "DEFAULT_ADMIN_PASSWORD",
                  "secretRef": "admin-password"
                },
                {
                  "name": "DEFAULT_VIEWER_PASSWORD",
                  "secretRef": "viewer-password"
                },
                {
                  "name": "GROQ_API_KEY",
                  "secretRef": "groq-api-key"
                }
              ],
              "resources": {
                "cpu": 1,
                "memory": "2Gi"
              },
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/system/health",
                    "port": 8000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "timeoutSeconds": 5,
                  "failureThreshold": 60,
                  "successThreshold": 1
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/system/health",
                    "port": 8000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 30,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3,
                  "successThreshold": 1
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2026-01-01').configuration.ingress.fqdn]"
    }
  }
}
